# =============================================================================
# HOLLOWPAW — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie para .env e preencha os tokens secretos no servidor de produção.
# NUNCA exponha estes tokens no frontend (HTML/JS público).
# =============================================================================

# Meta Pixel & Conversions API (CAPI)
META_PIXEL_ID=1576880640332577
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v20.0

# UTMify Integration (Backend Order Tracking)
UTMIFY_API_TOKEN=
UTMIFY_API_URL=https://api.utmify.com.br/api-credentials/orders

# Gateway de Pagamento / Bravo Webhook
BRAVO_API_KEY=
BRAVO_WEBHOOK_SECRET=

# Porta do servidor
PORT=8080
