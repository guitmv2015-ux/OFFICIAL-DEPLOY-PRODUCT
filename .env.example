# =============================================================================
# HOLLOWPAW — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Configure estas variáveis no painel da Vercel (Settings -> Environment Variables)
# ou em um arquivo .env local (ignorado pelo Git).
# NUNCA exponha tokens privados no frontend (HTML/JS público) ou em commits.
# =============================================================================

# TikTok Pixel & Events API (Server-Side)
TIKTOK_PIXEL_ID=DB477NJC77U2NTDCJ9JG
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Meta Pixel & Conversions API (CAPI)
META_PIXEL_ID=1576880640332577
META_ACCESS_TOKEN=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v20.0

# Gateway de Pagamento BravoPay (Server-Side API & Webhooks)
BRAVOPAY_API_URL=https://bravopay.club/api/v1
BRAVOPAY_API_TOKEN=
BRAVOPAY_PRODUCT_ID=
BRAVOPAY_WEBHOOK_SECRET=
BRAVO_API_KEY=
BRAVO_WEBHOOK_SECRET=

# UTMify Integration (Backend Order Tracking)
UTMIFY_API_TOKEN=
UTMIFY_API_URL=https://api.utmify.com.br/api-credentials/orders

# Porta do servidor local
PORT=8080
